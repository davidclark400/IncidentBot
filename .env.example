# compose.pilot.yaml loads this file. The ASP.NET Core process does not load
# .env files itself; `dotnet run` users must export credentials in their shell.

# Machine-specific application settings use ASP.NET Core's standard
# double-underscore environment-variable mapping to override appsettings.json.
Panko__PublicBaseUrl=https://panko.internal
CrumbSources__Nomad__BaseUrl=https://nomad.internal.example
CrumbSources__GitLab__BaseUrl=https://gitlab.internal.example
CrumbSources__Grafana__BaseUrl=https://grafana.internal.example
CrumbSources__Kafka__BaseUrl=https://grafana.internal.example
CrumbSources__VictoriaLogs__BaseUrl=https://victorialogs.internal.example
LiteLlm__BaseUrl=http://litellm.internal.example:4000
LiteLlm__QueryPlannerModel=panko-case-query-planner

# Browser, REST, MCP, and SignalR callers use the same signed bearer identity.
# The pilot ingress must strip client Authorization and inject a correctly
# issued Panko bearer token on HTTP and WebSocket requests. Replace these
# values with the deployment's OIDC issuer and exact proxy network.
JwtIdentity__Required=true
JwtIdentity__Authority=https://identity.internal.company
JwtIdentity__Issuer=https://identity.internal.company
JwtIdentity__Audience=panko
TrustedProxies__KnownNetworks__0=10.42.0.0/16

# Case metrics are exported over OTLP. Replace this with the
# deployment collector endpoint; OTEL_EXPORTER_OTLP_PROTOCOL may also be set
# when the collector does not use the default gRPC transport.
OTEL_SERVICE_NAME=panko
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4317

# Directory groups and exact Slack channel IDs are mapped to the same canonical
# team key used by Recipes. Set the Recipe's slackChannel to
# this same channel ID so interactive restart identity can be matched exactly.
TeamAuthorization__GroupTeamMappings__payments-responders=payments
Slack__ChannelTeams__C0123456789=payments

# Slack mention-to-query example. Replace the channel ID with the exact channel
# containing the bot; the mapped Recipe remains the deployment-owned allowlist.
Slack__PromptMentionsEnabled=true
Slack__PromptChannelRecipes__C0123456789=payments-production

# Secrets
POSTGRES_PASSWORD=replace-me
# Existing deployments default to the pre-rebrand physical database and volume.
# Set these to Panko-native values only for a clean installation or after a planned migration.
PANKO_POSTGRES_DB=panko
PANKO_POSTGRES_USER=panko
PANKO_POSTGRES_VOLUME=panko_postgres
PAGERDUTY_WEBHOOK_SECRET=replace-me
PAGERDUTY_API_TOKEN=replace-me
SLACK_BOT_TOKEN=replace-me
SLACK_APP_TOKEN=replace-me
NOMAD_TOKEN=replace-me
CONSUL_HTTP_TOKEN=replace-me
GITLAB_READ_TOKEN=replace-me
GRAFANA_SERVICE_TOKEN=replace-me
GRAFANA_KAFKA_READ_TOKEN=replace-me
VICTORIALOGS_TOKEN=replace-me
LITELLM_API_KEY=replace-me

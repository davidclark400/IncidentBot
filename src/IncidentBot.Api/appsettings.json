{
  "ConnectionStrings": {
    "IncidentBot": "Host=localhost;Port=5432;Database=incidentbot;Username=incidentbot;Password=incidentbot"
  },
  "IncidentBot": {
    "ProfilesPath": "config/investigation-profiles.yaml",
    "PublicBaseUrl": "http://localhost:5173",
    "EvidenceWindowMinutes": 30,
    "EvidenceMaximumItems": 250,
    "EvidenceMaximumBytes": 1048576,
    "RetentionDays": 30,
    "FingerprintRetentionDays": 365,
    "FingerprintAutomaticThreshold": 80,
    "FingerprintPossibleThreshold": 60,
    "FingerprintCandidateLookbackDays": 365,
    "FingerprintMaximumCandidates": 100,
    "FingerprintEscalationCount": 3,
    "FingerprintEscalationWindowDays": 7,
    "CollectionEnabled": true,
    "McpEnabled": true,
    "RequireSlackForReadiness": false
  },
  "PagerDuty": {
    "WebhookSecretEnv": "PAGERDUTY_WEBHOOK_SECRET",
    "ApiTokenEnv": "PAGERDUTY_API_TOKEN",
    "ApiBaseUrl": "https://api.pagerduty.com",
    "MaximumWebhookPayloadBytes": 262144,
    "RequireSignature": true
  },
  "Slack": {
    "Enabled": false,
    "ApiBaseUrl": "https://slack.com/api",
    "BotTokenEnv": "SLACK_BOT_TOKEN",
    "AppTokenEnv": "SLACK_APP_TOKEN",
    "ReconnectDelaySeconds": 5,
    "TimeoutSeconds": 20
  },
  "LiteLlm": {
    "BaseUrl": "http://litellm.internal:4000",
    "Model": "incident-summary",
    "ApiKeyEnv": "LITELLM_API_KEY",
    "TimeoutSeconds": 20,
    "InputCharacterBudget": 24000,
    "MaxOutputTokens": 1000
  },
  "IngressIdentity": {
    "Required": true,
    "HeaderName": "X-Forwarded-User"
  },
  "Demo": {
    "Enabled": false,
    "StepDelaySeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}

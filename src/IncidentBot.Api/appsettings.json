{
  "IncidentBot": {
    "ProfilesPath": "config/investigation-profiles.yaml",
    "KafkaMetricPacksPath": "config/kafka-metric-packs.yaml",
    "PublicBaseUrl": "http://localhost:5173",
    "EvidenceWindowMinutes": 30,
    "EvidenceMaximumWindowMinutes": 240,
    "EvidenceMaximumItems": 250,
    "EvidenceMaximumBytes": 1048576,
    "RetentionDays": 30,
    "FingerprintRetentionDays": 365,
    "FingerprintAutomaticThreshold": 80,
    "FingerprintPossibleThreshold": 60,
    "FingerprintCandidateLookbackDays": 365,
    "FingerprintMaximumCandidates": 100,
    "FingerprintEscalationCount": 3,
    "FingerprintEscalationWindowDays": 7,
    "FingerprintErrorTemplateWeight": 35,
    "FingerprintCodeLocationWeight": 25,
    "FingerprintComponentWeight": 15,
    "FingerprintSymptomWeight": 15,
    "FingerprintTitleWeight": 10,
    "CollectionEnabled": true,
    "McpEnabled": true,
    "RequireSlackForReadiness": false
  },
  "PagerDuty": {
    "WebhookSecretEnv": "PAGERDUTY_WEBHOOK_SECRET",
    "MaximumWebhookPayloadBytes": 262144,
    "PullTimeoutSeconds": 15,
    "MaximumApiResponseBytes": 1048576,
    "MaximumRecentIncidents": 100,
    "MaximumLookbackDays": 30,
    "RequireSignature": true
  },
  "EvidenceSources": {
    "PagerDuty": {
      "Mode": "api",
      "BaseUrl": "https://api.pagerduty.com",
      "CredentialEnv": "PAGERDUTY_API_TOKEN",
      "TimeoutSeconds": 8,
      "MaxItems": 10,
      "MaxBytes": 65536
    },
    "Nomad": {
      "Mode": "api",
      "BaseUrl": "https://nomad.internal.example",
      "CredentialEnv": "NOMAD_TOKEN",
      "TimeoutSeconds": 12,
      "MaxItems": 50,
      "MaxBytes": 131072
    },
    "GitLab": {
      "Mode": "api",
      "BaseUrl": "https://gitlab.internal.example",
      "CredentialEnv": "GITLAB_READ_TOKEN",
      "TimeoutSeconds": 12,
      "MaxItems": 30,
      "MaxBytes": 196608
    },
    "Grafana": {
      "Mode": "api",
      "BaseUrl": "https://grafana.internal.example",
      "CredentialEnv": "GRAFANA_SERVICE_TOKEN",
      "TimeoutSeconds": 12,
      "MaxItems": 50,
      "MaxBytes": 262144
    },
    "Kafka": {
      "Mode": "api",
      "BaseUrl": "https://grafana.internal.example",
      "CredentialEnv": "GRAFANA_KAFKA_READ_TOKEN",
      "TimeoutSeconds": 12,
      "MaxItems": 50,
      "MaxBytes": 262144
    },
    "VictoriaLogs": {
      "Mode": "api",
      "BaseUrl": "https://victorialogs.internal.example",
      "CredentialEnv": "VICTORIALOGS_TOKEN",
      "TimeoutSeconds": 12,
      "MaxItems": 30,
      "MaxBytes": 196608
    }
  },
  "Slack": {
    "Enabled": false,
    "PromptMentionsEnabled": false,
    "ApiBaseUrl": "https://slack.com/api",
    "BotTokenEnv": "SLACK_BOT_TOKEN",
    "AppTokenEnv": "SLACK_APP_TOKEN",
    "ReconnectDelaySeconds": 5,
    "TimeoutSeconds": 20,
    "MaximumEnvelopeBytes": 262144,
    "MaximumPromptCharacters": 2000,
    "PromptQueueCapacity": 32,
    "PromptWorkerCount": 1,
    "PromptRequestsPerMinutePerUser": 6,
    "PromptRequestsPerMinute": 30,
    "PromptTimeoutSeconds": 90,
    "AllowExternalSharedChannels": false,
    "PromptChannelProfiles": {}
  },
  "LiteLlm": {
    "BaseUrl": "http://litellm.internal:4000",
    "Model": "incident-summary",
    "QueryPlannerModel": "incident-query-planner",
    "ApiKeyEnv": "LITELLM_API_KEY",
    "TimeoutSeconds": 20,
    "InputCharacterBudget": 24000,
    "MaxOutputTokens": 1000
  },
  "IngressIdentity": {
    "Required": true,
    "HeaderName": "X-Forwarded-User"
  },
  "Demo": {
    "Enabled": false,
    "StepDelaySeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}

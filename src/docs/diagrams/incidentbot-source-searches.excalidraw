      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 2,
      "text": "PagerDuty\n\nGET /incidents/{pagerdutyId}\n\nExact incident lookup, not broad search.\nCaptures created time, current status,\nseverity and incident link.\n\nFinding: incident state\nTimeline: PagerDuty event",
      "rawText": "PagerDuty\n\nGET /incidents/{pagerdutyId}\n\nExact incident lookup, not broad search.\nCaptures created time, current status,\nseverity and incident link.\n\nFinding: incident state\nTimeline: PagerDuty event",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "pagerduty",
      "originalText": "PagerDuty\n\nGET /incidents/{pagerdutyId}\n\nExact incident lookup, not broad search.\nCaptures created time, current status,\nseverity and incident link.\n\nFinding: incident state\nTimeline: PagerDuty event",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gitlab",
      "type": "rectangle",
